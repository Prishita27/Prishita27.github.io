<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Block Blast Puzzle</title>
    <style>
        :root {
            --bg-color: #1a1a24;
            --panel-color: #272738;
            --grid-bg: #12121a;
            --cell-bg: #2d2d3f;
            --cell-hover: #3d3d54;
            --text-color: #ffffff;
            
            /* 5 Distinct Colors */
            --color-1: #ff4757; /* Red */
            --color-2: #2ed573; /* Green */
            --color-3: #1e90ff; /* Blue */
            --color-4: #ffa502; /* Orange */
            --color-5: #9b59b6; /* Purple */
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            user-select: none;
        }

        h1 {
            margin: 5px 0;
            font-size: 2rem;
            letter-spacing: 2px;
        }

        .score-container {
            font-size: 1.2rem;
            margin-bottom: 15px;
            background: var(--panel-color);
            padding: 8px 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        .game-board {
            display: grid;
            grid-template-columns: repeat(8, 45px);
            grid-template-rows: repeat(8, 45px);
            gap: 4px;
            background-color: var(--grid-bg);
            padding: 10px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.4);
            margin-bottom: 25px;
        }

        .cell {
            width: 45px;
            height: 45px;
            background-color: var(--cell-bg);
            border-radius: 6px;
            transition: background-color 0.15s;
        }

        .cell.highlight {
            background-color: var(--cell-hover);
        }

        .spawner-container {
            display: flex;
            gap: 20px;
            background-color: var(--panel-color);
            padding: 15px 25px;
            border-radius: 12px;
            min-height: 110px;
            min-width: 380px;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 16px rgba(0,0,0,0.4);
        }

        .piece-slot {
            width: 110px;
            height: 110px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: grab;
        }

        .piece-slot:active {
            cursor: grabbing;
        }

        .mini-grid {
            display: grid;
            gap: 2px;
        }

        .mini-cell {
            width: 24px;
            height: 24px;
            border-radius: 4px;
        }

        /* Color classes */
        .c-1 { background-color: var(--color-1); box-shadow: inset 0 0 6px rgba(0,0,0,0.3); }
        .c-2 { background-color: var(--color-2); box-shadow: inset 0 0 6px rgba(0,0,0,0.3); }
        .c-3 { background-color: var(--color-3); box-shadow: inset 0 0 6px rgba(0,0,0,0.3); }
        .c-4 { background-color: var(--color-4); box-shadow: inset 0 0 6px rgba(0,0,0,0.3); }
        .c-5 { background-color: var(--color-5); box-shadow: inset 0 0 6px rgba(0,0,0,0.3); }

        #game-over-screen {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.8);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

        #game-over-screen h2 {
            font-size: 3rem;
            color: #ff4757;
            margin-bottom: 10px;
        }

        button {
            background-color: var(--color-3);
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 1rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            transition: transform 0.1s;
        }

        button:hover {
            transform: scale(1.05);
        }
    </style>
</head>
<body>

    <h1>BLOCK BLAST</h1>
    <div class="score-container">Score: <span id="score">0</span></div>

    <div class="game-board" id="board"></div>

    <div class="spawner-container" id="spawner">
        <!-- Pieces generated via JS -->
    </div>

    <div id="game-over-screen">
        <h2>Game Over</h2>
        <p>Final Score: <span id="final-score">0</span></p>
        <button onclick="resetGame()">Play Again</button>
    </div>

<script>
    const BOARD_SIZE = 8;
    const COLORS = [1, 2, 3, 4, 5]; // 5 Colors mapped via CSS classes c-1 to c-5
    
    // Predefined block shapes
    const SHAPES = [
        [[1]], // 1x1
        [[1, 1]], // 1x2 Horizontal
        [[1], [1]], // 2x1 Vertical
        [[1, 1], [1, 1]], // 2x2 Square
        [[1, 1, 1]], // 1x3 Horizontal
        [[1], [1], [1]], // 3x1 Vertical
        [[1, 1, 1], [1, 1, 1], [1, 1, 1]], // 3x3 Square
        [[1, 0], [1, 1]], // L-Shape small
        [[1, 1, 1], [1, 0, 0]], // L-Shape large
        [[0, 1], [1, 1]] // Corner
    ];

    let board = Array(BOARD_SIZE).fill(0).map(() => Array(BOARD_SIZE).fill(0));
    let score = 0;
    let currentPieces = [null, null, null];
    let draggedPiece = null;

    const boardElement = document.getElementById('board');
    const spawnerElement = document.getElementById('spawner');
    const scoreElement = document.getElementById('score');
    const gameOverScreen = document.getElementById('game-over-screen');
    const finalScoreElement = document.getElementById('final-score');

    function initGame() {
        board = Array(BOARD_SIZE).fill(0).map(() => Array(BOARD_SIZE).fill(0));
        score = 0;
        scoreElement.innerText = score;
        gameOverScreen.style.display = 'none';
        renderBoard();
        generateNewPieces();
    }

    function renderBoard() {
        boardElement.innerHTML = '';
        for (let r = 0; r < BOARD_SIZE; r++) {
            for (let c = 0; c < BOARD_SIZE; c++) {
                const cell = document.createElement('div');
                cell.classList.add('cell');
                cell.dataset.row = r;
                cell.dataset.col = c;
                
                if (board[r][c] !== 0) {
                    cell.classList.add(`c-${board[r][c]}`);
                }

                // Drag and drop event listeners
                cell.addEventListener('dragover', handleDragOver);
                cell.addEventListener('dragleave', handleDragLeave);
                cell.addEventListener('drop', handleDrop);

                boardElement.appendChild(cell);
            }
        }
    }

    function getRandomShape() {
        const shapeTemplate = SHAPES[Math.floor(Math.random() * SHAPES.length)];
        const color = COLORS[Math.floor(Math.random() * COLORS.length)];
        return {
            matrix: shapeTemplate,
            color: color
        };
    }

    function generateNewPieces() {
        currentPieces = [getRandomShape(), getRandomShape(), getRandomShape()];
        renderSpawner();
        checkGameOver();
    }

    function renderSpawner() {
        spawnerElement.innerHTML = '';
        currentPieces.forEach((piece, index) => {
            const slot = document.createElement('div');
            slot.classList.add('piece-slot');
            
            if (piece) {
                const miniGrid = document.createElement('div');
                miniGrid.classList.add('mini-grid');
                const rows = piece.matrix.length;
                const cols = piece.matrix[0].length;
                
                miniGrid.style.gridTemplateColumns = `repeat(${cols}, 24px)`;
                miniGrid.style.gridTemplateRows = `repeat(${rows}, 24px)`;

                piece.matrix.forEach(r => {
                    r.forEach(val => {
                        const miniCell = document.createElement('div');
                        miniCell.classList.add('mini-cell');
                        if (val === 1) {
                            miniCell.classList.add(`c-${piece.color}`);
                        }
                        miniGrid.appendChild(miniCell);
                    });
                });

                slot.appendChild(miniGrid);
                slot.draggable = true;
                slot.addEventListener('dragstart', (e) => {
                    draggedPiece = { piece: piece, index: index };
                });
            }
            spawnerElement.appendChild(slot);
        });
    }

    // Drag & Drop Validation Logic
    function handleDragOver(e) {
        e.preventDefault();
        const target = e.target.closest('.cell');
        if (!target || !draggedPiece) return;

        clearHighlights();
        const startR = parseInt(target.dataset.row);
        const startC = parseInt(target.dataset.col);
        const matrix = draggedPiece.piece.matrix;

        if (canPlace(matrix, startR, startC)) {
            highlightCells(matrix, startR, startC, true);
        }
    }

    function handleDragLeave(e) {
        clearHighlights();
    }

    function handleDrop(e) {
        e.preventDefault();
        clearHighlights();
        const target = e.target.closest('.cell');
        if (!target || !draggedPiece) return;

        const startR = parseInt(target.dataset.row);
        const startC = parseInt(target.dataset.col);
        const matrix = draggedPiece.piece.matrix;
        const color = draggedPiece.piece.color;

        if (canPlace(matrix, startR, startC)) {
            // Place piece
            matrix.forEach((row, r) => {
                row.forEach((val, c) => {
                    if (val === 1) {
                        board[startR + r][startC + c] = color;
                        score += 1;
                    }
                });
            });

            currentPieces[draggedPiece.index] = null;
            draggedPiece = null;

            checkForClears();
            renderBoard();
            renderSpawner();

            // If all 3 pieces are used, generate a new set
            if (currentPieces.every(p => p === null)) {
                generateNewPieces();
            } else {
                checkGameOver();
            }
        }
    }

    function canPlace(matrix, startR, startC) {
        for (let r = 0; r < matrix.length; r++) {
            for (let c = 0; c < matrix[r].length; c++) {
                if (matrix[r][c] === 1) {
                    let boardR = startR + r;
                    let boardC = startC + c;
                    if (boardR >= BOARD_SIZE || boardC >= BOARD_SIZE || board[boardR][boardC] !== 0) {
                        return false;
                    }
                }
            }
        }
        return true;
    }

    function highlightCells(matrix, startR, startC, isValid) {
        for (let r = 0; r < matrix.length; r++) {
            for (let c = 0; c < matrix[r].length; c++) {
                if (matrix[r][c] === 1) {
                    let boardR = startR + r;
                    let boardC = startC + c;
                    if (boardR < BOARD_SIZE && boardC < BOARD_SIZE) {
                        const cell = document.querySelector(`[data-row='${boardR}'][data-col='${boardC}']`);
                        if (cell) cell.classList.add('highlight');
                    }
                }
            }
        }
    }

    function clearHighlights() {
        document.querySelectorAll('.cell').forEach(c => c.classList.remove('highlight'));
    }

    function checkForClears() {
        let rowsToClear = [];
        let colsToClear = [];

        // Check full rows
        for (let r = 0; r < BOARD_SIZE; r++) {
            if (board[r].every(val => val !== 0)) {
                rowsToClear.push(r);
            }
        }

        // Check full columns
        for (let c = 0; c < BOARD_SIZE; c++) {
            let colFull = true;
            for (let r = 0; r < BOARD_SIZE; r++) {
                if (board[r][c] === 0) {
                    colFull = false;
                    break;
                }
            }
            if (colFull) colsToClear.push(c);
        }

        // Clear rows and columns & add bonuses
        let clearedCount = rowsToClear.length + colsToClear.length;
        if (clearedCount > 0) {
            rowsToClear.forEach(r => {
                for (let c = 0; c < BOARD_SIZE; c++) board[r][c] = 0;
            });
            colsToClear.forEach(c => {
                for (let r = 0; r < BOARD_SIZE; r++) board[r][c] = 0;
            });

            // Score bonus for clearing lines
            score += clearedCount * 10 * BOARD_SIZE;
        }

        scoreElement.innerText = score;
    }

    function checkGameOver() {
        // Find if any available piece can fit anywhere on the board
        let availablePieces = currentPieces.filter(p => p !== null);
        if (availablePieces.length === 0) return;

        let canMoveAny = false;
        for (let pieceObj of availablePieces) {
            let matrix = pieceObj.matrix;
            for (let r = 0; r < BOARD_SIZE; r++) {
                for (let c = 0; c < BOARD_SIZE; c++) {
                    if (canPlace(matrix, r, c)) {
                        canMoveAny = true;
                        break;
                    }
                }
                if (canMoveAny) break;
            }
            if (canMoveAny) break;
        }

        if (!canMoveAny) {
            finalScoreElement.innerText = score;
            gameOverScreen.style.display = 'flex';
        }
    }

    function resetGame() {
        initGame();
    }

    // Start the game on load
    initGame();
</script>

</body>
</html>
